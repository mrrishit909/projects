{
 "service": "farm-crop-intelligence",
 "run": "demo-1",
 "tokens": {
  "agronomist": "farm-agronomist-demo",
  "analyst": "farm-analyst-demo",
  "viewer": "farm-viewer-demo"
 },
 "steps": [
  {
   "title": "Load a farm at day 90",
   "say": "An invented farm: three fields of 60 one-hectare zones (corn, soybean, wheat), 90 days of weather, soil probes, the water applied so far, and satellite NDVI images every five days to day 80, some lost to cloud. A yield model is trained on 24 past seasons and tested on 6 more.",
   "calls": [
    {
     "key": "load",
     "as": "agronomist",
     "method": "POST",
     "path": "/v1/farm:load",
     "body": {
      "seed": 17
     }
    },
    {
     "key": "fields",
     "as": "viewer",
     "method": "GET",
     "path": "/v1/fields"
    }
   ]
  },
  {
   "title": "New readings and a new image arrive",
   "say": "Three probe readings for the soybean field, one of them sent twice. Then the day-85 image is registered and detection runs over everything known: a patch of nine zones has fallen below its own normal on two images running. The day-90 image confirms it. The obvious rule, NDVI below 0.70, flags sandy ground as well.",
   "calls": [
    {
     "key": "tele",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/telemetry/batch",
     "body": {
      "readings": [
       {
        "sensor_id": "7bfb1da2-d38e-5e09-9843-0a0ca539ddc3",
        "ts": "2026-07-30T06:30:00Z",
        "value": 68.6,
        "unit": "mm"
       },
       {
