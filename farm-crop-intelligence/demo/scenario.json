  {
   "title": "The soybean field now",
   "say": "The NDVI map, the zones that are below their own normal, the soil water the model expects in every zone against what the probes read, and the scouting recommendation the detection raised.",
   "calls": [
    {
     "key": "health",
     "as": "viewer",
     "method": "GET",
     "path": "/v1/fields/d2c9459a-3271-5074-b109-f5228edaf282/health"
    }
   ]
  },
  {
   "title": "Forecast the harvest, with a band",
   "say": "For each field: the yield the model expects from the images and the water balance so far, with a 10 to 90% band, beside the crop's historical average. The band is checked for honesty in the evaluation.",
   "calls": [
    {
     "key": "y0",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/fields/4e59e629-71d1-5623-b7a5-0db643023b17/yield-forecast"
    },
    {
     "key": "y1",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/fields/d2c9459a-3271-5074-b109-f5228edaf282/yield-forecast"
    },
    {
     "key": "y2",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/fields/160fa852-1df8-5c25-a9fe-18d176046f3d/yield-forecast"
    }
   ]
  },
  {
   "title": "A 25% water restriction",
   "say": "The district cuts the farm's remaining water by a quarter. The planner tries water budgets for each field, plays every combination through the soil-water model on six sampled weather futures, and picks the one with the highest expected profit under the cap. The water goes where a millimetre earns most.",
   "calls": [
    {
     "key": "plan",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/irrigation-plan",
     "body": {
      "restriction": 0.25
     }
    }
   ]
  },
  {
   "title": "An agronomist accepts",
   "say": "Nothing changes until an agronomist accepts each field's budget. The analyst who asked for the plan is refused.",
   "calls": [
    {
     "key": "deny",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/recommendations/{{plan.recommendations.0.recommendation_id}}/accept",
     "expect_error": true
    },
    {
     "key": "ok0",
     "as": "agronomist",
     "method": "POST",
     "path": "/v1/recommendations/{{plan.recommendations.0.recommendation_id}}/accept"
    },
    {
     "key": "ok1",
     "as": "agronomist",
     "method": "POST",
     "path": "/v1/recommendations/{{plan.recommendations.1.recommendation_id}}/accept"
    },
    {
     "key": "ok2",
     "as": "agronomist",
     "method": "POST",
     "path": "/v1/recommendations/{{plan.recommendations.2.recommendation_id}}/accept"
    }
   ]
  },
  {
   "title": "The rest of the season as it really goes",
   "say": "The simulator knows the weather to come. The season is played out under the fixed schedule, the fixed schedule cut by a quarter, and the accepted budgets; and the yield forecasts are checked against what each field really gave.",
   "calls": [
    {
     "key": "replay",
     "as": "analyst",
     "method": "POST",
     "path": "/v1/scenarios"
    }
   ]
  },
  {
   "title": "The audit trail",
   "say": "Who loaded the farm, registered the images, forecast, planned and accepted: recorded in a log that cannot be edited.",
   "calls": [
    {
     "key": "audit",
     "as": "agronomist",
     "method": "GET",
     "path": "/v1/audit?limit=12"
    }
   ]
  }
 ]
